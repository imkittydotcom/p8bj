pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- p8 blackjack
-- by chloe and clemente

ruleset="casino"
deck={}

function  _init()
  deck=create_deck()
  deck=shuffle(deck)
  print_card(deal())
end

function _update()

end

function _draw()

end
-->8
-- card

suits={"s","h","d","c"}
ranks={"2","3","4","5","6","7","8","9","10","j","q","k","a"}

function create_deck()
  deck = {}
  for suit=1,#suits do
    for rank=1,#ranks do
      deck[#deck+1]={suits[suit],ranks[rank]}
    end
  end
  return deck
end

function print_card(card)
 print(card[1]..card[2])
end
-->8
-- shuffle

function shuffle(tbl)
  for i = #tbl, 2, -1 do
    local j = flr(rnd(i)) + 1
    tbl[i], tbl[j] = tbl[j], tbl[i]
  end
  return tbl
end
-->8
--deal

function deal()
		draw=deck[#deck]
		deck[#deck]=nil
		return draw
end
