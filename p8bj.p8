pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- p8 blackjack
-- by chloe and clemente

ruleset="casino"
deck={}
player_hand={}
dealer_hand={}
score={}
chips=100

function  _init()
  setup()
  deck=create_deck()
  deck=shuffle(deck)
  player_hand={deal(),deal()}
  dealer_hand={deal()}
end

function _update()

end

function _draw()
  cls(3)
  draw_hand(dealer_hand,0,0,true)
  draw_hand(player_hand,0,64)
end
-->8
-- card

suits={"s","h","d","c"}
ranks={"2","3","4","5","6","7","8","9","10","j","q","k","a"}

function create_deck()
  deck = {}
  for suit=1,#suits do
    for rank=1,#ranks do
      deck[#deck+1]={suits[suit],ranks[rank]}
    end
  end
  return deck
end

function print_card(card)
 print(card[1]..card[2])
end

function draw_card(card,x,y,flipped)
 flipped = flipped or false
 card_sprite = (flipped and 1 or 0)*4
 spr(card_sprite,x,y,4,5)
 if flipped do return end
 print(card[2],x+4,y+4,5)
 print(card[1],x+4,y+10)
end

card_width=8*4

function draw_hand(hand,x,y,dealer)
 dealer=dealer or false
 for card=1,#hand do
  draw_card(hand[card],x+(card-1)*8*4,y,(dealer and card==1))
 end
end
-->8
-- shuffle

function shuffle(tbl)
  for i = #tbl, 2, -1 do
    local j = flr(rnd(i)) + 1
    tbl[i], tbl[j] = tbl[j], tbl[i]
  end
  return tbl
end
-->8
--deal

function deal()
		draw=deck[#deck]
		deck[#deck]=nil
		return draw
end
-->8
-- setup

function setup()
  player_hand={}
  dealer_hand={}
  score = {["wins"]   =0,
   ["losses"] =0,
   ["ties"]   =0}
  chips = 100
end
